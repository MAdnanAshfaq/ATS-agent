# ─── ATS Agent — Environment Variables Template ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to Git.

# ── Database (Required for production on Render) ─────────────────────────────
# Get this from your NeonDB dashboard → Connection Details → Connection String
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── AI / Gemini API ──────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_backup_gemini_api_key_here

# ── Simplify Job Tracker (optional) ─────────────────────────────────────────
# Needed for real ATS score scraping via Simplify extension
SIMPLIFY_EMAIL=your_simplify_account_email@example.com
SIMPLIFY_PASSWORD=your_simplify_password

# ── HuggingFace API (optional — for AI Lab detector) ─────────────────────────
HF_API_KEY=hf_your_huggingface_token_here

# ── Colab AI Detector URL (optional) ─────────────────────────────────────────
# If you run the Colab notebook, paste the Gradio public URL here
COLAB_DETECTOR_URL=https://xxxx.gradio.live

# ── Flask Session Security ───────────────────────────────────────────────────
# Auto-generated on first run. On Render, set this manually in Environment Variables.
AUTH_SECRET_KEY=your_long_random_hex_secret_key

# ── Paths (local dev only — ignored in production) ───────────────────────────
BASE_RESUME_PATH=base_resume.json
OUTPUT_DIR=./output
