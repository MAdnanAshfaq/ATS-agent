# Gemini API Key (Get a free key from https://aistudio.google.com)
GEMINI_API_KEY=

# Optional Simplify Extension Credentials
SIMPLIFY_EMAIL=
SIMPLIFY_PASSWORD=

# Output Directory for Generated Resumes & Cover Letters
OUTPUT_DIR=output

# HuggingFace API Key (for AI Lab tab — get from https://huggingface.co/settings/tokens)
